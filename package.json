{
  "name": "hugo-aiv-logs",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "cookie:status": "bun run src/index.ts cookie:status",
    "cookie:import": "bun run src/index.ts cookie:import",
    "query": "bun run src/index.ts query",
    "classify:skeleton": "bun run src/index.ts classify:skeleton",
    "analyze": "bun run src/index.ts analyze",
    "mcp": "PORTLESS_STATE_DIR=.portless-sls PORTLESS_PORT=1878 PORTLESS_HTTPS=0 PORTLESS_LAN=0 PORTLESS_TLD=localhost bun x portless run --name sls -- bun run src/mcp.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@alicloud/log": "^1.2.6",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.2",
    "hono": "^4.12.23",
    "portless": "^0.13.1"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
