SLS_ENVIRONMENTS=alpha,production

# Console API query. Prefer `bun run cookie:auto`; only set these manually
# when browser import is unavailable.
SLS_CONSOLE_PRODUCTION_COOKIE=
SLS_CONSOLE_PRODUCTION_CSRF_TOKEN=

SLS_CONSOLE_ALPHA_COOKIE=
SLS_CONSOLE_ALPHA_CSRF_TOKEN=

# Query result cache. Use file by default; set auto/valkey after starting Valkey.
QUERY_CACHE_PROVIDER=file
QUERY_CACHE_TTL_SECONDS=3600
VALKEY_URL=redis://127.0.0.1:6379/0

# Optional OpenAI-compatible LLM analysis.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
